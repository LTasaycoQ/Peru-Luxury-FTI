---
import BaseLayout from '../layouts/BaseLayout.astro';
import { programs } from '../data/programs/programs-experiences';
import DetailPrograms from '../components/programs/ProgramsDetail/detailPrograms.astro';
import Fondo from '../components/Fondo.astro';

const data = programs.find(p => p.name === "eight");
const fondo = "https://res.cloudinary.com/dlgeap8h0/image/upload/f_auto,q_auto/v1772828345/jeremiah-berman-9dmycbFE7mQ-unsplash_11zon_j7htro.webp";
if (!data) return Astro.redirect('/404');

const pdfs = [
    { label: "Descargar PDF", image: "https://res.cloudinary.com/dlgeap8h0/image/upload/f_auto,q_auto/v1789571753/pdfIcon_idmrvg.webp", href: "/pdfs/eight-en.pdf", icon: "bi bi-file-earmark-pdf" },
    { label: "Descargar Word", image: "https://res.cloudinary.com/dlgeap8h0/image/upload/f_auto,q_auto/v1789571753/imageWord_qbttzt.webp", href: "/pdfs/eight-includes-en.pdf", icon: "bi bi-file-earmark-pdf" },
];
---

<BaseLayout title={data.title}>
    <Fondo fondo={`url(${fondo})`} />
    <main>
        <DetailPrograms
            title={data.title}
            programNoIncluye={data.programNoIncluye}
            programIncluye={data.programIncluye}
            programBreve={data.programBreve}
            programItenerario={data.programItenerario}
            imgCardLink={data.imgCardLink ?? []}
            pdfs={pdfs}
        />
    </main>
</BaseLayout>