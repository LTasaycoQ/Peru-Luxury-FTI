---
import BaseLayout from '../layouts/BaseLayout.astro';
import { programsEs } from '../data/programs/programs-experiences-translations';
import DetailPrograms from '../components/programs/ProgramsDetail/detailPrograms.astro';
import Fondo from '../components/Fondo.astro';

const data = programsEs.find(p => p.name === "ocho-noches-inolvidables");
const fondo = "https://res.cloudinary.com/dlgeap8h0/image/upload/f_auto,q_auto/v1772828345/jeremiah-berman-9dmycbFE7mQ-unsplash_11zon_j7htro.webp";
if (!data) return Astro.redirect('/404');


const pdfs = [
    { label: "Descargar PDF", image: "https://res.cloudinary.com/dlgeap8h0/image/upload/f_auto,q_auto/v1789571753/pdfIcon_idmrvg.webp", href: "/documents/A-Majestade_Inca-ESP.pdf", icon: "bi bi-file-earmark-pdf" },
    { label: "Descargar Word", image: "https://res.cloudinary.com/dlgeap8h0/image/upload/f_auto,q_auto/v1789571753/imageWord_qbttzt.webp", href: "/documents/A-Majestade_Inca-ESP.docx", icon: "bi bi-file-earmark-pdf" },
];

---

<BaseLayout title={data.title}>
    <Fondo fondo={`url(${fondo})`} />
    <main>
        <DetailPrograms
            title={data.title}
            programNoIncluye={data.programNoIncluye}
            programIncluye={data.programIncluye}
            programBreve={data.programBreve}
            programItenerario={data.programItenerario}
            imgCardLink={data.imgCardLink ?? []}
            pdfs={pdfs}


            includes="Incluye:"
            notincludes="No Incluye:"

            breve="Breve"
            itinerario="Itinerario"
            noInclude="Incluye"
            
            textContainerTitle="Encuentra el viaje perfecto para ti."
            textDescription="Cada viajero es diferente. Descubre más ideas de itinerarios y experiencias por todo Perú, o deja que nuestros especialistas diseñen un viaje totalmente personalizado, adaptado a tus intereses, fechas y estilo de viaje preferido."
            email="Email"
            formularioTxt="Consultar ahora"

        />
    </main>
</BaseLayout>