---
const { fondo } = Astro.props;
---
<section class="fondo-section fade-in">
    <div class="hero-overlay"></div>

    <div class="fondo">
    </div>
</section>

<style define:vars={{ fondo }}>
    
    .fade-in {
        opacity: 0.8;
        animation: fadeIn 1s forwards;
    }
    @keyframes fadeIn {
        to { opacity: 1; }
    }
    .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
        to bottom, 
        #000000b2, 
        rgba(0, 0, 0, 0.555),
        #00000013, 
        #00000048 72%, 
        #000000af
    );
    pointer-events: none;
  }


    .fondo {
        width: 100%;
        height: 100vh;
        background-image: var(--fondo);
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
    }

    @media (width <= 830px) {
        .fondo {
            
        }
    }

    .fondo-section {
        overflow: hidden;
    }

    .fondo-section:hover .fondo {
        transform: scale(1);
    }

    @keyframes efectZoom {
        from { 
            transform: scale(1); 
        }
        to { 
            transform: scale(1.2); 
        }
    } 



</style>