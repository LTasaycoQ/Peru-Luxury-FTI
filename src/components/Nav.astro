---
import { destinations } from "../data/destinations/destinatios";
import HeaderTop from "./HeaderTop.astro";
import { Image } from "astro:assets";
import logo from "../assets/logo/PLJ-LOGO-1.webp";
---

<header class="header" id="mainHeader">
  <div class="nav-container">
    <nav class="nav">
      <div class="nav-wrapper">
        <a href="/" class="logo-link">
          <Image
            format="png"
            src={logo}
            loading="eager"
            class="logo"
            alt="logo-peru-luxy"
          />
        </a>

        <button
          id="btnMenu"
          aria-label="Abrir menú"
          aria-expanded="false"
          class="menu-button"
        >
          <i id="openMenu" class="bi bi-list menu-icon-open"></i>
          <i id="closeMenu" class="bi bi-x-lg menu-icon-close hidden"></i>
        </button>

        <ul class="nav-links">
          <li class="nav-item">
            <button id="btnSubmenuDesktop" class="nav-button">
              <i id="iconSubmenu" style="color: #FFBF00;" class="bi bi-caret-right-fill submenu-icon"></i>
              <a style="font-size: 15px;" href="/destinations">DESTINATIONS</a>
            </button>
            <div id="submenu" class="submenu hidden">
              <ul class="submenu-list">
                {
                  destinations.map((d) => (
                    <li class="submenu-item">
                      <a
                        class="submenu-link"
                        href={`/destinations/${d.distrito}`}
                      >
                        {d.distrito.toUpperCase().replace(/-/g, " ")}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </li>
          <li class="nav-item">
            <a href="/tour-itineraries">TOUR ITINERARIES</a>
          </li>
          <li class="nav-item"><a href="/about-us">ABOUT US</a></li>
          <li>
            <div class="top-bar-container tamano--feature" style="width: 450px;">
              <a href="https://api.whatsapp.com/send?phone=51982836947" target="_blank" class="top-bar-link">
                <i style="color: #FFBF00" class="bi bi-telephone"></i> +51 982 836 947
              </a>
              <a href="mailto:sales@PeruLuxuryJourneys.com" target="_blank" class="top-bar-link">
                <i class="bi bi-envelope" style="color: #FFBF00"></i>sales@PeruLuxuryJourneys.com
              </a>
            </div>
          </li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="mobile-menu">
    <div id="menuResponsive" class="mobile-menu-content hidden">
      <div class="mobile-menu-item">
        <a class="mobile-menu-link" href="/destinations">DESTINATIONS</a>
        <button
          id="btnSubMenuResponsive"
          aria-label="Ver destinos"
          aria-expanded="false"
          class="mobile-submenu-button"
        >
          <i id="iconSubMenuResponsiveIcon" class="bi bi-caret-down-fill"></i>
        </button>
      </div>

      <div id="submenuResponsive" class="mobile-submenu hidden">
        <ul class="mobile-submenu-list">
          {
            destinations.map((d) => (
              <li>
                <a
                  class="mobile-submenu-link"
                  href={`/destinations/${d.distrito}`}
                >
                  {d.distrito.charAt(0).toUpperCase() +
                    d.distrito.slice(1).replace(/-/g, " ")}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mobile-menu-item">
        <a class="mobile-menu-link" href="/tour-itineraries">TOUR ITINERARIES</a>
      </div>
      <div class="mobile-menu-item">
        <a class="mobile-menu-link" href="/about-us">ABOUT US</a>
      </div>
      <div class="mobile-menu-item">
        <a
          class="mobile-menu-link whatsapp-link"
          href="https://api.whatsapp.com/send?phone=51982836947"
          target="_blank"
        >
          <i class="bi bi-whatsapp"></i> +51 982 836 947
        </a>
      </div>
      <div class="mobile-menu-item">
        <a
          class="mobile-menu-link email-link"
          href="mailto:sales@PeruLuxuryJourneys.com"
          target="_blank"
        >
          <i class="bi bi-envelope"></i>sales@PeruLuxuryJourneys.com
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
    const header = document.getElementById('mainHeader');

    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    });

    const btnMenu = document.getElementById("btnMenu");
    const openMenuIcon = document.getElementById("openMenu");
    const closeMenuIcon = document.getElementById("closeMenu");
    const menuResponsive = document.getElementById("menuResponsive");

    if (btnMenu && menuResponsive) {
      btnMenu.addEventListener("click", () => {
        const isHidden = menuResponsive.classList.contains("hidden");
        menuResponsive.classList.toggle("hidden");
        openMenuIcon?.classList.toggle("hidden", isHidden);
        closeMenuIcon?.classList.toggle("hidden", !isHidden);
        btnMenu.setAttribute("aria-expanded", String(isHidden));

        // 👇 Toggle clase menu-open en el header
        if (header) {
          header.classList.toggle("menu-open", isHidden);
        }
      });
    }

    const btnSubmenuDesktop = document.getElementById("btnSubmenuDesktop");
    const submenuDesktop = document.getElementById("submenu");
    const iconSubmenu = document.getElementById("iconSubmenu");

    if (btnSubmenuDesktop && submenuDesktop) {
      btnSubmenuDesktop.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = !submenuDesktop.classList.contains("hidden");
        submenuDesktop.classList.toggle("hidden");
        if (iconSubmenu) iconSubmenu.style.transform = isOpen ? "rotate(0deg)" : "rotate(90deg)";
        btnSubmenuDesktop.setAttribute("aria-expanded", String(!isOpen));
      });

      document.addEventListener("click", (e) => {
        if (!btnSubmenuDesktop.contains(e.target)) {
          submenuDesktop.classList.add("hidden");
          if (iconSubmenu) iconSubmenu.style.transform = "rotate(0deg)";
          btnSubmenuDesktop.setAttribute("aria-expanded", "false");
        }
      });
    }

    const btnSubMenuResponsive = document.getElementById("btnSubMenuResponsive");
    const submenuResponsive = document.getElementById("submenuResponsive");
    const iconSubMenuResponsiveIcon = document.getElementById("iconSubMenuResponsiveIcon");

    if (btnSubMenuResponsive && submenuResponsive) {
      btnSubMenuResponsive.addEventListener("click", () => {
        const isOpen = !submenuResponsive.classList.contains("hidden");
        submenuResponsive.classList.toggle("hidden");
        if (iconSubMenuResponsiveIcon) {
          iconSubMenuResponsiveIcon.style.transform = isOpen ? "rotate(0deg)" : "rotate(180deg)";
        }
        btnSubMenuResponsive.setAttribute("aria-expanded", String(!isOpen));
      });
    }
</script>

<style>
    .top-bar {
        background-color: transparent;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: flex-end;
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        padding: 10px;
        font-size: 16px;
        color: white;
        transition: all 0.3s ease;
    }

    @media (width < 64rem) {
        .top-bar{
            display: none;
        }
    }

    .top-bar-container {
      display:flex;
      gap: 30px;
      font-size: 15px;
      align-items:center;
    }

    .top-bar-link {
        text-decoration: none;
        color: white;
        display: flex;
        gap: 10px;
        position: relative;
        transition: color 0.3s;
    }

    .top-bar-link:hover {
        color: #d9b244;
    }

    @media (max-width: 1024px) {
        .top-bar {
            flex-direction: column;
            font-size: 12px;
        }
        .top-bar-container {
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 0px;
        }
        .top-bar-link {
            justify-content: center;
            width: 100%;
        }
    }

    @media (min-width: 1024px) { .top-bar-container { width: 87%; } }
    @media (min-width: 1280px) { .top-bar-container { width: 68%; } }
    @media (min-width: 1536px) { .top-bar-container { width: 68%; } }
    @media (max-width: 768px) { .top-bar-container { gap: 0px; } }
</style>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .header {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    z-index: 1000;
    position: fixed;
    top: 0;
    left: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 100%);
    color: white;
    transition: background 0.3s ease, color 0.3s ease, box-shadow 0.3s ease;
  }

  .header.scrolled {
    background: white;
    color: #333;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  }

  .header.scrolled .nav-item > a,
  .header.scrolled .nav-button,
  .header.scrolled .top-bar-link {
    color: #333;
  }

  .header.scrolled .top-bar {
      border-bottom: 1px solid #eaeaea;
  }

  .header.scrolled .logo-link {
    filter: none;
  }

  /* ============ CUANDO EL MENÚ MÓVIL ESTÁ ABIERTO ============ */
  .header.menu-open {
    background: #1a1a1a;
    color: white;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .header.menu-open .nav-item > a,
  .header.menu-open .nav-button,
  .header.menu-open .top-bar-link {
    color: white;
  }

  .header.menu-open .top-bar {
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .header.menu-open .menu-button {
    border: 1px solid rgba(255, 255, 255, 0.5);
    color: white;
  }

  .header.menu-open .logo-link {
    filter: brightness(20);
  }

  .nav-container {
    width: 100%;
    background-color: transparent;
    display: flex;
    padding: 15px 90px;
    justify-content: center;
    align-items: center;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 60px;
    list-style: none;
    margin-left: auto;
  }

  .nav {
    width: 100%;
    padding: 5px;
  }

  @media (max-width: 1400px){
     .nav-container {
          padding: 15px 10px;
    }

    .nav-links {
      gap: 30px;
    }
  }

  @media (max-width: 1280px) {
    .nav { width: 90%; }
  }

  .nav-wrapper {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: center;
  }

  .logo-link { filter: brightness(20); display: inline-block; }

  .logo {
    width: 220px;
    transition: filter 0.3s ease;
  }

  @media (max-width: 640px) {
    .logo { width: 210px; padding: 7px; }
  }

  .menu-button {
    display: none;
    border-radius: 10px;
    padding: 14px;
    width: 48px;
    height: 48px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.5);
    cursor: pointer;
    color: white;
    transition: all 0.3s ease;
  }

  .header.scrolled .menu-button {
      border: 1px solid #ccc;
      color: #333;
  }

  .menu-icon-open, .menu-icon-close { font-size: 22px; }

  .nav-item { position: relative; }

  .nav-item > a {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 0.3s;
    text-decoration: none;
    color: white;
    position: relative;
  }

  .nav-item > a:hover { color: #d9b244; }

  .nav-button {
    display: flex;
    align-items: center;
    gap: 5px;
    background-color: transparent;
    border: none;
    cursor: pointer;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 0.3s;
    position: relative;
    color: white;
  }

  .nav-button a { text-decoration: none; color: inherit; }
  .nav-button:hover { color: #d9b244; }
  .submenu-icon { transition: transform 0.35s ease; }

  .submenu {
    position: absolute;
    top: 45px;
    left: -20px;
    z-index: 50;
    background-color: #393939;
    width: 225px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
    border-radius: 4px;
  }

  .submenu-list {
    list-style: none;
    font-size: 14px;
    color: white;
    width: 100%;
  }

  .submenu-item { display: flex; }

  .submenu-link {
    padding: 15px;
    width: 100%;
    text-decoration: none;
    color: white;
    transition: background-color 0.25s;
    font-size: 13px;
    text-transform: uppercase;
  }

  .submenu-link:hover { background-color: #515050; }

  .mobile-menu { display: none; width: 100%; }

  .mobile-menu-content {
    width: 100%;
    background-color: #1a1a1a;
    color: white;
    z-index: 40;
    position: absolute;
    transform-origin: top center;
    animation: animation-desliz 0.5s ease-in-out;
  }

  .mobile-menu-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #333;
  }

  .mobile-menu-link {
    padding: 14px;
    flex: 1;
    letter-spacing: 0.05em;
    text-decoration: none;
    color: white;
    display: block;
  }

  .whatsapp-link i, .email-link i { color: #d9b244; margin-right: 10px; }
  .whatsapp-link, .email-link { display: flex; gap: 10px; }

  .mobile-submenu-button {
    padding: 14px;
    background-color: transparent;
    border: none;
    cursor: pointer;
    color: white;
  }

  .mobile-submenu-button i { font-size: 14px; transition: transform 0.35s ease; }

  .mobile-submenu {
    background-color: #2e2e2e;
    transform-origin: top center;
    animation: animation-desliz 0.5s ease-in-out;
  }

  .mobile-submenu-list { list-style: none; font-size: 13px; padding: 8px 0; }

  .mobile-submenu-link {
    display: flex;
    padding: 12px 12px 12px 24px;
    text-decoration: none;
    color: white;
    transition: background-color 0.25s;
  }

  .mobile-submenu-link:hover { background-color: #515050; }

  .hidden { display: none; }

  @keyframes animation-desliz {
    to { transform: scaleY(1); }
    from { transform: scaleY(0); }
  }

  @media (max-width: 1024px) {
    .nav-links { display: none; }
    .menu-button { display: flex; }
    .mobile-menu { display: block; }
  }
</style>